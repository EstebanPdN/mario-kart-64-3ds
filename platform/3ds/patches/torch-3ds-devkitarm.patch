 int32_t ZWrapper::Close(void) {
+#if defined(__3DS__) || defined(PLATFORM_3DS)
+    if(!this->mArchiveOpen) {
+        return -1;
+    }
+    const bool finalized = mz_zip_writer_finalize_archive(this->mArchive) == MZ_TRUE;
+    const uint64_t archiveBytes = this->mArchive->m_archive_size;
+    const int writerError = this->mWriter->errorNumber;
+    const char* writerStage = this->mWriter->stage;
+    const bool ended = mz_zip_writer_end(this->mArchive) == MZ_TRUE;
+    bool flushed = false;
+    bool closed = false;
+    int closeError = 0;
+    if(this->mWriter->file != nullptr) {
+        errno = 0;
+        flushed = std::fflush(this->mWriter->file) == 0;
+        if(!flushed) closeError = errno != 0 ? errno : EIO;
+        errno = 0;
+        closed = std::fclose(this->mWriter->file) == 0;
+        if(!closed && closeError == 0) closeError = errno != 0 ? errno : EIO;
+        this->mWriter->file = nullptr;
+    }
+    this->mArchiveOpen = false;
+    delete this->mArchive;
+    this->mArchive = nullptr;
+    delete this->mWriter;
+    this->mWriter = nullptr;
+    if(!finalized || !ended || !flushed || !closed) {
+        char message[320] = {};
+        std::snprintf(message, sizeof(message),
+                      "Could not finalize the O2R archive on the SD card (entries=%lu bytes=%llu stage=%s writer_errno=%d close_errno=%d)",
+                      static_cast<unsigned long>(this->mEntriesWritten), static_cast<unsigned long long>(archiveBytes),
+                      writerStage, writerError, closeError);
+        Mk64InstallLogWrite(message);
+        throw std::runtime_error(message);
+    }
+    char message[192] = {};
+    std::snprintf(message, sizeof(message), "O2R finalized: %lu entries, %llu archive bytes.",
+                  static_cast<unsigned long>(this->mEntriesWritten), static_cast<unsigned long long>(archiveBytes));
+    Mk64InstallLogWrite(message);
+#else
     this->mZip->save(this->mPath);
+#endif
     return 0;
 }
