 #include "spdlog/spdlog.h"
 #include <Companion.h>
+#if defined(__3DS__) || defined(PLATFORM_3DS)
+#include <cerrno>
+#include <climits>
+#include <cstdio>
+#include <cstring>
+#include <stdexcept>
+#include <miniz/zip_file.hpp>
+
+extern "C" void Mk64InstallLogWrite(const char* message);
+
+namespace {
+constexpr size_t kMk64ZipWriteChunkSize = 64 * 1024;
+}
+
+struct ZWrapper::Mk64ZipFileWriter {
+    FILE* file = nullptr;
+    int errorNumber = 0;
+    const char* stage = "none";
+};
+
+static size_t Mk64ZipWrite(void* opaque, mz_uint64 fileOffset, const void* buffer, size_t size) {
+    auto* writer = static_cast<ZWrapper::Mk64ZipFileWriter*>(opaque);
+    if (writer == nullptr || writer->file == nullptr || fileOffset > LONG_MAX) {
+        if (writer != nullptr) {
+            writer->stage = "seek";
+            writer->errorNumber = EFBIG;
+        }
+        return 0;
+    }
+
+    errno = 0;
+    if (std::fseek(writer->file, static_cast<long>(fileOffset), SEEK_SET) != 0) {
+        writer->stage = "seek";
+        writer->errorNumber = errno != 0 ? errno : EIO;
+        return 0;
+    }
+
+    const auto* bytes = static_cast<const unsigned char*>(buffer);
+    size_t totalWritten = 0;
+    while (totalWritten < size) {
+        const size_t chunkSize = std::min(size - totalWritten, kMk64ZipWriteChunkSize);
+        errno = 0;
+        const size_t written = std::fwrite(bytes + totalWritten, 1, chunkSize, writer->file);
+        totalWritten += written;
+        if (written != chunkSize) {
+            writer->stage = "write";
+            writer->errorNumber = errno != 0 ? errno : EIO;
+            return totalWritten;
+        }
+    }
+    return size;
+}
+#endif
 #include <miniz/zip_file.hpp>
 
 namespace fs = std::filesystem;
 
 ZWrapper::ZWrapper(const std::string& path) {
     this->mPath = path;
+#if defined(__3DS__) || defined(PLATFORM_3DS)
+    this->mArchive = new mz_zip_archive{};
+    this->mWriter = new Mk64ZipFileWriter{};
+    this->mArchiveOpen = false;
+    this->mEntriesWritten = 0;
+    this->mPayloadBytesWritten = 0;
+#else
     this->mZip = new miniz_cpp::zip_file;
+#endif
 }
 
 int32_t ZWrapper::CreateArchive() {
     SPDLOG_INFO("Loaded ZIP (O2R) archive: {}", mPath.c_str());
+#if defined(__3DS__) || defined(PLATFORM_3DS)
+    if(fs::exists(mPath)) {
+        fs::remove(mPath);
+    }
+    this->mWriter->file = std::fopen(mPath.c_str(), "wb");
+    if(this->mWriter->file == nullptr) {
+        throw std::runtime_error("Could not open the temporary O2R archive on the SD card");
+    }
+    this->mArchive->m_pWrite = Mk64ZipWrite;
+    this->mArchive->m_pIO_opaque = this->mWriter;
+    this->mArchiveOpen = mz_zip_writer_init(this->mArchive, 0) == MZ_TRUE;
+    if(!this->mArchiveOpen) {
+        std::fclose(this->mWriter->file);
+        this->mWriter->file = nullptr;
+        throw std::runtime_error("Could not create the O2R archive on the SD card");
+    }
+    Mk64InstallLogWrite("O2R writer opened with 64 KiB chunked SD writes.");
+#endif
     return 0;
 }
 
