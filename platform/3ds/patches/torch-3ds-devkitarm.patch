+bool Companion::ExportBinaryResult(ParseResultData& result) {
+    if(!result.data.has_value()) {
+        return false;
+    }
+
+    const auto factory = this->GetFactory(result.type);
+    if(!factory.has_value()) {
+        throw std::runtime_error("No factory available while exporting binary asset '" + result.name + "'");
+    }
+    const auto exporter = factory->get()->GetExporter(ExportType::Binary);
+    if(!exporter.has_value()) {
+        return false;
+    }
+    if(this->gCurrentWrapper == nullptr) {
+        throw std::runtime_error("Binary archive writer is unavailable while exporting '" + result.name + "'");
+    }
+
+    std::ostringstream stream;
+    auto data = result.data.value();
+    exporter->get()->Export(stream, data, result.name, result.node, &result.name);
+    auto serialized = stream.str();
+    std::vector<char> binaryData(serialized.begin(), serialized.end());
+    this->gCurrentWrapper->AddFile(result.name, std::move(binaryData));
+
+    for(auto& entry : this->gCompanionFiles) {
+        auto output = (this->gCurrentDirectory / entry.first).string();
+        std::replace(output.begin(), output.end(), '\\', '/');
+        this->gCurrentWrapper->AddFile(output, std::move(entry.second));
+    }
+    this->gCompanionFiles.clear();
+    return true;
+}
