+namespace {
+constexpr size_t kMk64ZipWriteChunkSize = 64 * 1024;
+
+bool Mk64WriteAll(FILE* file, const void* buffer, size_t size) {
+    if (file == nullptr) {
+        errno = EBADF;
+        return false;
+    }
+    const auto* bytes = static_cast<const unsigned char*>(buffer);
+    size_t totalWritten = 0;
+    while (totalWritten < size) {
+        const size_t chunkSize = std::min(size - totalWritten, kMk64ZipWriteChunkSize);
+        errno = 0;
+        const size_t written = std::fwrite(bytes + totalWritten, 1, chunkSize, file);
+        totalWritten += written;
+        if (written != chunkSize) {
+            if (errno == 0) errno = EIO;
+            return false;
+        }
+    }
+    return true;
+}
+
+bool Mk64WriteU16(FILE* file, uint16_t value) {
+    const unsigned char bytes[2] = {
+        static_cast<unsigned char>(value & 0xFF),
+        static_cast<unsigned char>((value >> 8) & 0xFF),
+    };
+    return Mk64WriteAll(file, bytes, sizeof(bytes));
+}
+
+bool Mk64WriteU32(FILE* file, uint32_t value) {
+    const unsigned char bytes[4] = {
+        static_cast<unsigned char>(value & 0xFF),
+        static_cast<unsigned char>((value >> 8) & 0xFF),
+        static_cast<unsigned char>((value >> 16) & 0xFF),
+        static_cast<unsigned char>((value >> 24) & 0xFF),
+    };
+    return Mk64WriteAll(file, bytes, sizeof(bytes));
+}
+
+bool Mk64AppendFile(FILE* output, FILE* input, uint64_t* bytesWritten) {
+    if (output == nullptr || input == nullptr) {
+        errno = EBADF;
+        return false;
+    }
+    errno = 0;
+    if (std::fseek(input, 0, SEEK_SET) != 0) {
+        if (errno == 0) errno = EIO;
+        return false;
+    }
+    unsigned char buffer[kMk64ZipWriteChunkSize];
+    while (true) {
+        const size_t read = std::fread(buffer, 1, sizeof(buffer), input);
+        if (read > 0) {
+            if (!Mk64WriteAll(output, buffer, read)) {
+                return false;
+            }
+            if (bytesWritten != nullptr) {
+                *bytesWritten += read;
+            }
+        }
+        if (read < sizeof(buffer)) {
+            if (std::ferror(input) != 0) {
+                errno = EIO;
+                return false;
+            }
+            return true;
+        }
+    }
+}
+}
