+const uint8_t* Interpreter::GetMaskedTextureReplacementData(const RawTexMetadata* metadata) const {
+    if (metadata == nullptr || metadata->resource == nullptr) {
+        return nullptr;
+    }
+
+    const std::string_view key = GetBaseTexturePath(metadata->resource->GetInitData()->Path);
+    auto it = mMaskedTextures.find(key);
+    if (it == mMaskedTextures.end()) {
+        return nullptr;
+    }
+
+    return it->second.replacementData;
+}
