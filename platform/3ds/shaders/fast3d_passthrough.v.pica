; Fast3D supplies homogeneous clip-space positions, normalized texture
; coordinates, and a single varying combiner input. Preserve w so PICA200 does
; the perspective divide and perspective-correct texture interpolation.

.fvec projection[4]

.constf shaderConstants(1.0, 0.0, 0.0, 0.0)

.out outpos position
.out outtc0 texcoord0
.out outtc1 texcoord1
.out outclr color

.in inpos v0
.in intex0 v1
.in intex1 v2
.in incolor v3

.proc main
    dp4 r0.x, projection[0], inpos
    dp4 r0.y, projection[1], inpos
    dp4 r0.z, projection[2], inpos
    dp4 r0.w, projection[3], inpos

    ; PICA clips z to [-w, 0]. Clamp there after applying the OpenGL-to-PICA
    ; depth conversion; triangles crossing w=0 are clipped on the CPU.
    min r0.z, shaderConstants.y, r0.z
    max r0.z, r0.z, -r0.w
    mov outpos, r0
    mov outtc0, intex0
    mov outtc1, intex1
    mov outclr, incolor
    end
.end
