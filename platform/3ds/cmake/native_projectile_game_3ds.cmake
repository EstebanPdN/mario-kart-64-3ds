if(MK64_3DS_NATIVE_PROJECTILE_LAB)
    file(READ "${SPAGHETTIKART_ROOT}/src/actors/banana/render.inc.c" nativeBanana)
    string(REPLACE "render_set_position(sp3C, 0) == 0" "gMatrixObjectCount >= MTX_OBJECT_POOL_SIZE" nativeBanana "${nativeBanana}")
    string(REPLACE "gSPDisplayList(gDisplayListHead++, &common_model_banana);"
        "Mk64NativeVegetationEnqueue(21, gDisplayListHead, &sp3C[0][0]);" nativeBanana "${nativeBanana}")
    string(REPLACE "gSPDisplayList(gDisplayListHead++, &common_model_flat_banana);"
        "Mk64NativeVegetationEnqueue(22, gDisplayListHead, &sp3C[0][0]);" nativeBanana "${nativeBanana}")
    file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/generated/native_banana_3ds.inc.c" "${nativeBanana}")
    string(REPLACE "actors/banana/render.inc.c" "native_banana_3ds.inc.c" SPAGHETTIKART_3DS_ACTORS_TEXT "${SPAGHETTIKART_3DS_ACTORS_TEXT}")

    # Keep the production visibility boundary: culled actors never open a child.
    set(nativeFake "${FAKE_BOX_FIXED}")
    set(fakeRoots common_model_fake_itembox D_0D003090 D_0D003158 D_0D0031B8 D_0D003128 D_0D0031E8 D_0D003188 D_0D0030F8)
    set(fakeIds 23 14 15 16 17 18 19 20)
    set(index 0)
    foreach(root IN LISTS fakeRoots)
        list(GET fakeIds ${index} rootId)
        set(model someMatrix2)
        if(rootId GREATER 14 AND rootId LESS 21)
            set(model someMatrix3)
        endif()
        set(before "gSPDisplayList(gDisplayListHead++, ${root});")
        string(FIND "${nativeFake}" "${before}" found)
        if(found LESS 0)
            message(FATAL_ERROR "Native fake-box source root changed: ${root}")
        endif()
        string(REPLACE "${before}" "Mk64NativeVegetationEnqueue(${rootId}, gDisplayListHead, &${model}[0][0]);" nativeFake "${nativeFake}")
        math(EXPR index "${index}+1")
    endforeach()
    foreach(model someMatrix2 someMatrix3)
        string(REPLACE "!render_set_position(${model}, 0)" "gMatrixObjectCount >= MTX_OBJECT_POOL_SIZE" nativeFake "${nativeFake}")
    endforeach()
    foreach(flag G_LIGHTING G_CULL_BACK)
        string(REPLACE "gSPClearGeometryMode(gDisplayListHead++, ${flag});"
            "Mk64NativeItemBoxState(gDisplayListHead, ${flag}, 0, ~0u, 0);" nativeFake "${nativeFake}")
    endforeach()
    string(REPLACE "gSPSetGeometryMode(gDisplayListHead++, G_CULL_BACK);"
        "Mk64NativeItemBoxState(gDisplayListHead, 0, G_CULL_BACK, ~0u, 0);" nativeFake "${nativeFake}")
    string(REGEX REPLACE "gDPSetRenderMode\\(gDisplayListHead\\+\\+, ([A-Za-z0-9_]+), ([A-Za-z0-9_]+)\\);"
        "Mk64NativeItemBoxState(gDisplayListHead, 0, 0, (\\1 | \\2), 0);" nativeFake "${nativeFake}")
    string(REPLACE "gDPSetCombineMode(gDisplayListHead++, G_CC_MODULATEIA, G_CC_MODULATEIA);" "/* The native shade draw overwrites this source combine. */" nativeFake "${nativeFake}")
    string(REPLACE "gDPSetBlendMask(gDisplayListHead++, 0xFF);" "/* Source no-op. */" nativeFake "${nativeFake}")
    file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/generated/native_fake_item_box_3ds.inc.c" "${nativeFake}")
    string(FIND "${SPAGHETTIKART_3DS_ACTORS_TEXT}" "\"fake_item_box_render_3ds.inc.c\"" fakeInclude)
    if(fakeInclude LESS 0)
        message(FATAL_ERROR "Native fake-box production include changed")
    endif()
    string(REPLACE "\"fake_item_box_render_3ds.inc.c\"" "\"native_fake_item_box_3ds.inc.c\"" SPAGHETTIKART_3DS_ACTORS_TEXT "${SPAGHETTIKART_3DS_ACTORS_TEXT}")

    string(FIND "${SPAGHETTIKART_3DS_ACTORS_TEXT}" "void render_actor_shell(" shellBegin)
    string(FIND "${SPAGHETTIKART_3DS_ACTORS_TEXT}" "UNUSED s16 D_802B8808" shellEnd)
    if(shellBegin LESS 0 OR shellEnd LESS shellBegin)
        message(FATAL_ERROR "Native shared shell actor boundary changed")
    endif()
    math(EXPR shellBytes "${shellEnd}-${shellBegin}")
    string(SUBSTRING "${SPAGHETTIKART_3DS_ACTORS_TEXT}" ${shellBegin} ${shellBytes} oldShell)
    set(nativeShell "${oldShell}")
    string(REPLACE "render_set_position(matrix, 0) == 0" "gMatrixObjectCount >= MTX_OBJECT_POOL_SIZE" nativeShell "${nativeShell}")
    string(FIND "${nativeShell}" "    gDPLoadTextureBlock(" drawBegin)
    string(FIND "${nativeShell}" "    // @port Pop the transform id." drawEnd)
    if(drawBegin LESS 0 OR drawEnd LESS drawBegin)
        message(FATAL_ERROR "Native shell texture/model tail changed")
    endif()
    math(EXPR drawBytes "${drawEnd}-${drawBegin}")
    string(SUBSTRING "${nativeShell}" ${drawBegin} ${drawBytes} oldDraw)
    string(REPLACE "${oldDraw}" "    Mk64NativeShellEnqueue(gDisplayListHead, &matrix[0][0],\n        shell->type == ACTOR_GREEN_SHELL ? 0 : (shell->type == ACTOR_RED_SHELL ? 1 : (shell->type == ACTOR_BLUE_SPINY_SHELL ? 2 : ~0u)), index, reverseShell);\n\n" nativeShell "${nativeShell}")
    # The shared production patch already opens after culling and closes on
    # matrix-pool exhaustion. Preserve both boundaries exactly.
    string(REPLACE "${oldShell}" "${nativeShell}" SPAGHETTIKART_3DS_ACTORS_TEXT "${SPAGHETTIKART_3DS_ACTORS_TEXT}")

    foreach(kind green_shell blue_and_red_shells)
        file(READ "${SPAGHETTIKART_ROOT}/src/actors/${kind}/render.inc.c" nativeWrapper)
        string(REPLACE "gDPLoadTLUT_pal256(gDisplayListHead++, common_tlut_green_shell);" "Mk64NativeProjectilePalette(gDisplayListHead, 0);" nativeWrapper "${nativeWrapper}")
        string(REPLACE "gDPLoadTLUT_pal256(gDisplayListHead++, &gTLUTRedShell);" "Mk64NativeProjectilePalette(gDisplayListHead, 1);" nativeWrapper "${nativeWrapper}")
        string(REPLACE "gDPLoadTLUT_pal256(gDisplayListHead++, common_tlut_blue_shell);" "Mk64NativeProjectilePalette(gDisplayListHead, 2);" nativeWrapper "${nativeWrapper}")
        file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/generated/native_${kind}_3ds.inc.c" "${nativeWrapper}")
        string(REPLACE "actors/${kind}/render.inc.c" "native_${kind}_3ds.inc.c" SPAGHETTIKART_3DS_ACTORS_TEXT "${SPAGHETTIKART_3DS_ACTORS_TEXT}")
    endforeach()
    string(FIND "${SPAGHETTIKART_3DS_ACTORS_TEXT}" "void init_red_shell_texture(void) {" paletteBegin)
    string(FIND "${SPAGHETTIKART_3DS_ACTORS_TEXT}" "UNUSED void func_80297944" paletteEnd)
    if(paletteBegin LESS 0 OR paletteEnd LESS paletteBegin)
        message(FATAL_ERROR "Native red-shell palette initialization boundary changed")
    endif()
    math(EXPR paletteBytes "${paletteEnd}-${paletteBegin}")
    string(SUBSTRING "${SPAGHETTIKART_3DS_ACTORS_TEXT}" ${paletteBegin} ${paletteBytes} oldPalette)
    string(REPLACE "${oldPalette}" "void init_red_shell_texture(void) {
    const void* source = LOAD_ASSET(common_tlut_green_shell);
    Mk64NativeBuildRedShellPalette(source, gTLUTRedShell);
}

" SPAGHETTIKART_3DS_ACTORS_TEXT "${SPAGHETTIKART_3DS_ACTORS_TEXT}")
    string(PREPEND SPAGHETTIKART_3DS_ACTORS_TEXT [=[#include "native_projectile_contract_3ds.h"
]=])
endif()
