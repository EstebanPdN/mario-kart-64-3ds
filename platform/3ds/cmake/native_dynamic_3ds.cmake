if(MK64_3DS_NATIVE_FULL_GAME AND NOT MK64_3DS_NATIVE_DYNAMIC)
    message(FATAL_ERROR "Complete native integration requires native typed dynamic producers")
endif()
# Compile-time producer migration. All generated files stay in the build tree.
if(MK64_3DS_NATIVE_DYNAMIC)
    if(NOT MK64_3DS_NATIVE_FULL_GAME)
        message(FATAL_ERROR "Native dynamic producers require full-game integration")
    endif()
    find_package(Python3 REQUIRED COMPONENTS Interpreter)
    set(nativeEmitDir "${CMAKE_CURRENT_BINARY_DIR}/generated/native-emit")
    file(MAKE_DIRECTORY "${nativeEmitDir}")
    foreach(generator generate_native_emit.py generate_native_embedded.py)
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
            "${MK64_3DS_SOURCE_ROOT}/platform/3ds/cmake/${generator}")
    endforeach()
    execute_process(COMMAND "${Python3_EXECUTABLE}"
        "${MK64_3DS_SOURCE_ROOT}/platform/3ds/cmake/generate_native_emit.py"
        --output "${nativeEmitDir}" COMMAND_ERROR_IS_FATAL ANY)
    execute_process(COMMAND "${Python3_EXECUTABLE}"
        "${MK64_3DS_SOURCE_ROOT}/platform/3ds/cmake/generate_native_embedded.py"
        --root "${MK64_3DS_SOURCE_ROOT}/third_party/SpaghettiKart"
        --output "${nativeEmitDir}" COMMAND_ERROR_IS_FATAL ANY)
    set(module 0)
    foreach(relative harbour_masters.c racing/skybox_and_splitscreen.c ending/dl_unk_80284EE0.c)
        set(original "${MK64_3DS_SOURCE_ROOT}/third_party/SpaghettiKart/src/${relative}")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${original}")
        if(relative MATCHES "\\.cpp$")
            set(target mk64-3ds-game-engine)
            set(extension cpp)
        else()
            set(target mk64-3ds-game-core)
            set(extension c)
        endif()
        get_target_property(nativeSources ${target} SOURCES)
        list(FIND nativeSources "${original}" index)
        if(index LESS 0)
            message(FATAL_ERROR "Native embedded producer source was not owned by ${target}: ${relative}")
        endif()
        list(REMOVE_AT nativeSources ${index})
        set_property(TARGET ${target} PROPERTY SOURCES "${nativeSources}")
        target_sources(${target} PRIVATE "${nativeEmitDir}/native-embedded-${module}.${extension}")
        math(EXPR module "${module}+1")
    endforeach()
    foreach(target mk64-3ds-game-core mk64-3ds-game-engine)
        get_target_property(nativeProducerSources ${target} SOURCES)
        foreach(producer IN LISTS nativeProducerSources)
            if(NOT producer MATCHES "platform/3ds/")
                set_property(SOURCE "${producer}" APPEND_STRING PROPERTY COMPILE_FLAGS
                    " -include \"${nativeEmitDir}/native_emit.generated.h\"")
            endif()
        endforeach()
        target_include_directories(${target} PRIVATE "${nativeEmitDir}")
        target_compile_definitions(${target} PRIVATE MK64_3DS_NATIVE_DYNAMIC=1)
    endforeach()
    set_source_files_properties(platform/3ds/source/gbi_middleware_3ds.cpp
        PROPERTIES COMPILE_DEFINITIONS MK64_NATIVE_GBI_IMPLEMENTATION=1)
    target_sources(mk64-3ds-game-runtime PRIVATE platform/3ds/source/native_dynamic_3ds.cpp
        "${nativeEmitDir}/native_embedded_registry.cpp")
    target_include_directories(mk64-3ds-game-runtime PRIVATE "${nativeEmitDir}")
    target_compile_definitions(mk64-3ds-game-runtime PRIVATE MK64_3DS_NATIVE_DYNAMIC=1)
endif()
